{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Debugging with Visualizer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Binary_Search.exe", // change the .exe file
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
