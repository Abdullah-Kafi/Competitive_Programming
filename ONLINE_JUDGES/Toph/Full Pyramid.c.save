///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>

int main() {
//    int n = 5;
//    printf("T%*sA", n, " ");
    int n;
    scanf("%d", &n);
    for(int i = 1; i <= n; i++) {
        for(int j = 1; j <= i; j++) {
            if(j == i) {
                printf("%*s", n )
            }
            printf("*");
            if(i != j) {
                printf(" ");
            }
        }
        printf("\n");
    }
    return 0;
}

