#include<stdio.h>

int main() {
    int i, N, K, A, count = 0; //Initializing the variable to 0
    scanf("%d %d", &N, &K);//Taking input the total number to be tested if divisible by K
    for(i = 1; i <= N; i++) { //This loop is for taking each number
        scanf("%d", &A); //The number which is to be tested, denoted by A
        if(A % K == 0) {
            count++; // If the number is evenly divisible by K, then the value of count will increase by 1
        }
    }
    printf("%d\n", count); //Finally print the number
    return 0;
}
