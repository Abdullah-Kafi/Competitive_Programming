///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>

int main() {
    int p, l, t;
    scanf("%d", &t);
    while(t--) {
        scanf("%d %d", &p, &l);
        if( ( l * 1.0 / p ) * 100 >= 75) {
            printf("YES\n");
        } else {
            printf("No\n");
        }
    }
    return 0;
}

