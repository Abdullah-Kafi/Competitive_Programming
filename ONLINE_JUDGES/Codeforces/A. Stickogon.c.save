///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>
///A. Stickogon


int main()
{
    ///freopen("input.txt", "r", stdin);

    int ar[100], t, n;
    scanf("%d", &t);
    while(t--)
    {
        int count[101] = {0}, ans = 0;
        scanf("%d", &n);
        for(int i = 0; i < n; i++)
        {
            scanf("%d", &ar[i]);
            count[ar[i]]++;
        }
        for(int i = 0; i < 101; i++)
        {
            ans += (count[i] / 3);                                                                                                                               
        }
        printf("%d\n", ans);
    }
    return 0;
}
