///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>

int main() {
    int t, num, even = 0, odd = 0, positive = 0, negative = 0;
    scanf("%d", &t);
    while(t--) {
        scanf("%d", &num);
        if(num < 0) {
            negative++;
        }
        if(num > 0) {
            positive++;
        }
        if(num % 2 == 0) {
            even++;
        }
        if(num % 2 != 0) {
            odd++;
        }
    }
    printf("Even: %d\nOdd: %d\nPositive: %d\nNegative: %d\n", even, odd, positive, negative);
    return 0;
}

