void solve()
{
    int a, b; scanf("%d %d", &a, &b);

    if(a % b || b % a)
        printf("%d\n", abs(a - b) / 10 + 1);
    else if( ! (a % b) || ! ())
        printf("%d\n", abs(a - b) / 10);
    else
        printf("0\n");
}

int main()
{
    #ifndef ONLINE_JUDGE
        /// freopen("input.txt", "r", stdin);
    #endif

    t_c
        solve();

    return 0;
}
