///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>

int main()
{
    freopen("input.txt", "r", stdin);

    int t, h, m;
    scanf("%d", &t);
    while(t--)
    {
        scanf("%d:%d", &h, &m);
        if(h == 12)
            printf("12:%02d PM\n", m);
        else if(h == 0)
            printf("12:%02d AM\n", m);
        else if(h > 12)
            printf("%02d:%02d PM\n", h - 12, m);
        else if(h < 12)
            printf("%02d:%02d AM\n", h, m);
    }
    return 0;
}
