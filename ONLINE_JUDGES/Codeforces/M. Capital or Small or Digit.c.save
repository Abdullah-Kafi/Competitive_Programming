#include<stdio.h>

int main() {
    char ch;
    scanf("%c", &ch);
    if(ch >= 0 && ch <= 9) {
        printf("IS DIGIT\n");
    }
    else if(ch >= 'a' && ch <= 'z') {
        printf("ALPHA\nIS SMALL\n");
    }
    else {
        
    }
    return 0;
}

