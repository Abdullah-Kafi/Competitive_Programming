#include<stdio.h>
///A. Team

int main() 
{
    ///freopen("input.txt", "r", stdin);
    
    int t, a, b, c, count = 0;
    scanf("%d", &t);
    while(t--)
    {
        scanf("%d %d %d", &a, &b, &c);
        if(a + b + c >= 2)
        {
            count++;
        }
    }
    return 0;
}
