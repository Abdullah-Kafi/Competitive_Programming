///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>

int main() {
    int a, b, s;
    scanf("%d %c %d", &a, &s, &b);
    if(s == '+') {
        printf("%d\n", a + b);
    }
    else if(s == '-') {
        printf("%d\n", a - b);
    }
    else if(s == '+') {
        printf("%d\n", a + b);
    }
    else {
        printf("%d\n", a + b);
    }
    return 0;
}
