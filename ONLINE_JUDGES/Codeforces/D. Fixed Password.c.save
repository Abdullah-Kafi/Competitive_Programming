#include<stdio.h>

int main() {  
    int n;
    scanf("%d", &n);
    while(1) {
        scanf("%d", &n);
        if(n == 1999) {
            printf("Correct\n");
            break;
        }
        else {
            printf("Correct\n");
        }
    }
    return 0;
}

