///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>

int main() {
    int a, b;
    char sign;
    scanf("%d %c %d", &a, &sign, &b);
    if(sign == '<') {
        if(a < b) {
            printf("Right\n");
        }
        else {
            printf("Wrong\n");
        }
    }
    else if(sign == '>') {
        if(a > b) {
            printf("Right\n");
        }
        else {
            printf("Wrong\n");
        }
    }
    else if(sign == '=') {
        if(a == b) {
            printf("Right\n");
        }
        else {
            printf("Wrong\n");
        }
    }
    return 0;
}

