void solve()
{
    int n, x;
    scanf("%d %d", &n, &x);
    if(n == 1 || n == 2)
        printf()
    if(n % x)
        printf("%d\n", (n - 2) / x + 2);
    else
        printf("%d\n", (n - 2) / x + 1);
}

