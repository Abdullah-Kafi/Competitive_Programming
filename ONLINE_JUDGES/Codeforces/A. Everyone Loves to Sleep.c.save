void solve()
{
    int n, h, m, minH = INT_MAX, a, b, hf, mf;
    scanf("%d %d %d", &n, &h, &m);
    for(int i = 1; i <= n; i++)
    {
        scanf("%d %d", &a, &b);
        if(a < minH)
        {
            hf = a;
            mf = b;
            minH = a;
        }
    }

    if(h == hf && m == mf)
        printf("0 0\n");
    else if(h > hf && m > mf)
        printf("%d %d\n", h - 12 + hf - 1, 60 - m + mf);
        
    else if(h > hf && m < mf)
        printf("%d %d\n", h - 12 + hf, mf - m);
        
    else if(h < hf && m > mf)
        printf("%d %d\n", , 60 - m + mf);
        
    else if(h < hf && m < mf)
        printf("%d %d\n", hf - h, mf - m);
    
}

int main()
{
    #ifndef ONLINE_JUDGE
        /// freopen("input.txt", "r", stdin);
    #endif

    testCase
        solve();

    return 0;
}



