///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>
///C. Prepend and Append

int main()
{
    ///freopen("input.txt", "r", stdin);

    int t, n;
    char s[2001];
    scanf("%d", &t);
    while(t--)
    {
        scanf("%d", &n);
        int count = n;
        scanf("%s", s);
        for(int i = 0; i < n / 2; i++)
        {
            if(s[i] == s[n - 1 - i])
                break;
            else
            {
                count -= 2;
            }
        }
        printf("%d\n", n);
    }
    return 0;
}
