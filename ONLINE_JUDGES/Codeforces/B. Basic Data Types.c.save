///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>

    int main() {
    int number;
    long long longNum;
    char character;
    float floatNum;
    double doubleNum;

    scanf("%d %lld %c %f %lf", &number, &longNum, &character, &floatNum, &doubleNum);
    printf("%d\n", number);
    printf("%lld\n", longNum);
    printf("%c\n", character);
    printf("%f\n", floatNum);
    printf("%lf\n", doubleNum);

    return 0;
}

