///Praise be to ALLAH

#include<stdio.h>
///A. Twin Permutations

int main() 
{
    ///freopen("input.txt", "r", stdin);
    
    int t, n, ar[101];
    scanf("%d", &t);
    while(t--)
    {
        scanf("%d", &n);
        for(int i = 0; i < n; i++)
        {
            scanf("%d", &ar[i]);
        }
    }
    return 0;
}
