///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>
#include<math.h>

int main() {
    int n, count = 0;
    scanf("%d", &n);
    if(n == 1) {
        printf("NO\n");
        break
    }
    for(int i = 2; i <= sqrt(n); i++) {
        if(n % i == 0) {
            count++;
        }
    }
    if(count == 0) {
        printf("YES\n");
    }
    else {
        printf("NO\n");
    }
    return 0;
}

