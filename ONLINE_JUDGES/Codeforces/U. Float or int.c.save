///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>
#include<math.h>

int main() {
    double n;
    scanf("%lf", &n);
    if( ( n - floor(n) ) != 0.0 ) {
        printf("float %.0lf %lf\n", floor(n), n - floor(n));
    }
    else {
        printf("")
    }
    return 0;
}

