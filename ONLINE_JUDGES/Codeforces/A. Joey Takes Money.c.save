///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>
///A. Joey Takes Money

int main()
{
    ///freopen("input.txt", "r", stdin);

    long long t, ar[55], n;
    scanf("%lld", &t);
    while(t--)
    {
        long long sum = 1;
        scanf("%lld", &n);
        for(long long i = 0; i < n; i++)
        {
            scanf("%lld", &ar[i]);
            sum *= ar[i];
        }
        printf("%lld\n", ( sum + n - 1 ) * 2022);
    }
    return 0;
}
