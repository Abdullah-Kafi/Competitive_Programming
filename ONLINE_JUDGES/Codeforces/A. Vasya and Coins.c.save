#include<stdio.h>
///A. Vasya and Coins

int main() 
{
    ///freopen("input.txt", "r", stdin);
    
    int t, a, b;
    scanf("%d", &t);
    while(t--)
    {
        scanf("%d %d", &a, &b);
        if(a == 0 && b != 0)
            printf("1\n");
        else if(a != 0 && b == 0)
            printf("%d\n", a +)
    }
    return 0;
}
