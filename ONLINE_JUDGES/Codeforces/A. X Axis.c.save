#include<stdio.h>
#include<math.h>
#include<stdlib.h>

#define testCase int __; scanf("%d", &__); while(__--)

void sort(int ar[], int n)
{
    for(int i = 0; i < n - 1; i++)
    {
        for(int j = i + 1; j < n; j++)
        {
            if(ar[i] > ar[j])
                swap(&ar[i], &ar[j]);
        }
    }
}

void swap(int* a, int* b)
{
    int t = *a;
    *a = *b;
    *b = t;
}

void solve()
{
    int x1, x2, x3, ar[3];
    scanf("%d %d %d", &x1, &x2, &x3);

    int a = x1;
    ar[0] = abs(x1 - a) + abs(x2 - a) + abs(x3 - a);

    a = x2;
    ar[1] = abs(x1 - a) + abs(x2 - a) + abs(x3 - a);

    a = x3;
    ar[2] = abs(x1 - a) + abs(x2 - a) + abs(x3 - a);

    sort(ar, 3);

    printf("%d\n", ar[0]);
}

int main()
{
    #ifndef ONLINE_JUDGE
        /// freopen("input.txt", "r", stdin);
    #endif

    testCase
        solve();

    return 0;
}


