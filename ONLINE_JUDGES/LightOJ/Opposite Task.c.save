///In The Name of ALLAH
///Praise be to ALLAH

#include<stdio.h>

int main() {
    int i, T, n;
    scanf("%d", &T);
    for(i = 1; i <= T; i++) {
        scanf("%d", &n);
        printf("%d %d\n", (n / 2), n - (n / 2));
    }
    return 0;
}

