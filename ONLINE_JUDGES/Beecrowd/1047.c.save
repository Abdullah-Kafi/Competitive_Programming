///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>

int main() {
    int h1, m1, h2, m2;
    scanf("%d %d %d %d", &h1, &m1, &h2, &m2);

    if( ( h1 == h2 ) && ( m1 == m2 ) && ( m1 == h2 ) ) {
        printf("O JOGO DUROU 24 HORA(S) E 0 MINUTO(S)\n");
    }

    else if( ( h1 > h2 ) && ( m1 > m2 ) ) {
        printf("O JOGO DUROU %d HORA(S) E %d MINUTO(S)\n", ( 24 - h1 + h2 - 1 ), ( 60 - m1 + m2 ));
    }

    else if( ( h1 > h2 ) && ( m1 < m2 ) ) {
        printf("O JOGO DUROU %d HORA(S) E %d MINUTO(S)\n", ( 24 - h1 + h2), ( m2 - m1 ));
    }

    else if( ( h1 < h2 ) && ( m1 > m2 ) ) {
        printf("O JOGO DUROU %d HORA(S) E %d MINUTO(S)\n", ( h2 - h1 - 1 ), ( 60 - m1 + m2 ));
    }

    else if( ( h1 < h2 ) && ( m1 < m2 ) ) {
        printf("O JOGO DUROU %d HORA(S) E %d MINUTO(S)\n", ( h2 - h1 ), ( m2 - m1 ));
    }

    else if( ( h1 == h2 ) && ( m1 > m2 ) ) {
        printf("O JOGO DUROU %d HORA(S) E %d MINUTO(S)\n", 0, ( 60 - m1 + m2 ));
    }

    else if( ( h1 == h2 ) && ( m1 < m2 ) ) {
        printf("O JOGO DUROU %d HORA(S) E %d MINUTO(S)\n", 0, ( m2 - m1 ));
    }

    else if( ( h1 > h2 ) && ( m1 == m2 ) ) {
        printf("O JOGO DUROU %d HORA(S) E %d MINUTO(S)\n", ( 24 - h1 + h2), 0);
    }

    else if( ( h1 < h2 ) && ( m1 == m2 ) ) {
        printf("O JOGO DUROU %d HORA(S) E %d MINUTO(S)\n", ( h2 - h1), 0);
    }

    return 0;
}
