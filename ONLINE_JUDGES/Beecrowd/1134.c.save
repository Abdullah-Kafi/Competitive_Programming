///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>

int main() {
    int n, Alcool = 0, Gasolina = 0, Diesel = 0;
    scanf("%d", &n);
    while(1) {
        if(n > 4 || n < 1) {
            scanf("%d", &n);
        }
        if(n == 1) {
            Alcool++;
        }
        else if(n == 2) {
            Gasolina++;
        }
        else if(n == 3) {
            Diesel++;
        }
        else if(n == 4) {
            break;
        }
    }
    printf("MUITO OBRIGADO\n");
    printf("Alcool: %d\n", Alcool);
    printf("Gasolina: %d\n", Gasolina);
    printf("Diesel: %d\n", Diesel);
    return 0;
}
