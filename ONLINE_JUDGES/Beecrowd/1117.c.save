///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>

int main() {
    double n, total = 0.0;
    int count = 0;

    while(1) {
        if(n >= 0.0 && n <= 10.0) {
            total += n;
            count++;
        }
        else {
            printf("nota invalida\n");
        }
        if(count == 2) {
            break;
        }
        scanf("%lf", &n);
    }
    printf("media = %.2lf\n", total);
    return 0;
}

