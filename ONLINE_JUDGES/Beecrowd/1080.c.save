#include<stdio.h>

int main()
{
    int t = 100, n, max = 0, position;
    for(int i = 1; i <= t; i++) {
        scanf("%d", &n);
        max = ( n > max ) ? n, position = i : max;
//        if(n == max) {
//            position = i;
//        }
    }
    printf("%d\n", max);
    printf("%d\n", position);
    return 0;
}
