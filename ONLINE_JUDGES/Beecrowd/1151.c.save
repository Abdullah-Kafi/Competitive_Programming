///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>

int main()
{
    int a = -1, b = 1, i = 1, n, sum = 0;
    scanf("%d", &n);
    while(i <= n)
    {
        sum = a + b;
        a = b;
        b = sum;
        printf("%d", sum);
        if(i != n) {
            printf(" ");
        }
        i++;
    }
    printf("\n");
    return 0;
}

