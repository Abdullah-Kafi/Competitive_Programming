    /// std::lower_bound()
    /// lower_bound would point to the first number that is greater than or equal to 100, or it would return num.end() if no such number exists
    vector<int> num {1, 2, 4, 5, 6, 10, 2, 3, 234};

    // Sort the vector for correct `lower_bound` behavior
    sort(num.begin(), num.end());
    
    // Find the first element that is >= 100
    auto f = lower_bound(num.begin(), num.end(), 100);
    
    // Check if lower_bound returned a valid iterator
    if (f != num.end()) {
        cout << *f << endl; // Should output the first element >= 100 if it exists
        if(*f == 100) cout << "Found" << endl;
        else cout << "Not found" << endl;
    } else {
        cout << "100 not found and is larger than all elements." << endl;
    }
