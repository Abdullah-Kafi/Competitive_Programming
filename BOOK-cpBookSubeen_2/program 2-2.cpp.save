#include<bits/stdc++.h>
using namespace std;
int main()
{
    ///pointer - pointer is a "special type of variable" that stores another variable's address
    int x = 10;

    int* intTypePointer;
    /// int *p ---> interger pointer p
    /// *p ---> content of p

    intTypePointer = &x;
    ///this pointer stores the Address of x

    cout << "*intTypePointer = " << *intTypePointer << "\n";
    cout << "Value of intTypePointer is " << intTypePointer << "\n";

    return 0;
}


