#include <stdio.h>

int main()
{
    int n = 10;

    if(n < 30) {
        printf("%d is less than 30. \n", n);
    }
    else if(n < 20) {
        printf("%d is less than 20. \n", n);
    }
    if(n < 10) {
        printf("%d is less than 10. \n", n);
    }
    else if(n < 50) {
        printf("%d is less than 50. \n", n);
    }

    return 0;
}
