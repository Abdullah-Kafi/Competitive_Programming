///In the name of ALLAH, The Most Gracious and The Most Merciful
///Praise be to ALLAH

#include<stdio.h>

int main()
{
    int n, m;
    scanf("%d", &);
    for(int j = 1; j <= 20; j++)
    {
        m = j;
        for(int i = 1; i <= 10; i++)
        {
            printf("%d X %d = %d\n", n, i, m);
            m += j;
        }
    }
    return 0;
}
