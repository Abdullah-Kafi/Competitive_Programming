#include<bits/stdc++.h>
using namespace std;

int main()
{
    ///counts how many 2 divides 100:
    int n = 100, cnt = 0;

    while(n % 2 == 0)
    {
        n /= 2;
        cnt++;
    }
    cout << cnt << '\n';

