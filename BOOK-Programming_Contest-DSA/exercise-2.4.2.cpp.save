/**
       1
      121
     12321
*/
    for(int i = 1; i <= n; i++)
    {
        for(int j = i; j <= n - 1; j++)
            cout << " ";

        int k = 2;
        for(int j = 1; j <= 2 * i - 1; j++)
        {
            if(j < (2 * i - 1) / 2 + 1)
                cout << j;
            else if(j > (2 * i - 1) / 2 + 1)
            {
                cout << j - k;
                k += 2;
            }
            else cout << j;
        }
        cout << '\n';
    }

    return 0;
}
