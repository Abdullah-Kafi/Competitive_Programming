#include<bits/stdc++.h>
using namespace std;

long double factorial(int n)
{
    long double fact = 1;

    for(int i = 1; i <= n; i++)
        fact *= i;

    cout << fact << "\n";
}

int main()
{
    int n; cin >> n;

    long double fact = 1;

    for(int i = 1; i <= n; i++)
        fact *= i;

    cout << fact << "\n";
    return 0;
}
